{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@getitdone/shared": ["../shared/src/index.ts"],
      "@getitdone/shared/types.js": ["../shared/src/types.ts"],
      "@getitdone/shared/types": ["../shared/src/types.ts"]
    }
  },
  "include": ["src"]
}
