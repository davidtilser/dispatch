# API defaults to loopback. Set HOST=0.0.0.0 only in a trusted demo environment.
HOST=127.0.0.1
PORT=3001
# Web voice: add your API key, then run npm run voice:setup to create the agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Reserved for a future integration; no current code reads NEBIUS_API_KEY.
NEBIUS_API_KEY=
# Optional Claude managed agents. Set the API key and environment ID together
# with the crawl and/or manager agent ID for the feature you want to enable.
ANTHROPIC_API_KEY=
DISPATCH_ENV_ID=
DISPATCH_CRAWL_AGENT_ID=
DISPATCH_MANAGER_AGENT_ID=

# Optional absolute SQLite path; defaults to .demo/dispatch.sqlite in the repo root.
# DEMO_DB_PATH=/absolute/path/to/dispatch.sqlite
